#!/bin/sh
set -eu

backup_root=/var/backups/orbitbeacon
timestamp=$(date -u +%Y%m%dT%H%M%SZ)
backup_dir=${backup_root}/${timestamp}

install -d -o orbitbeacon -g orbitbeacon -m 0700 "$backup_root" "$backup_dir"
runuser -u orbitbeacon -- /usr/local/bin/orbitbeacon-server backup \
    --online \
    --config /etc/orbitbeacon/server.json \
    --output "$backup_dir/orbitbeacon.db"
install -o orbitbeacon -g orbitbeacon -m 0600 \
    /var/lib/orbitbeacon/secrets.key "$backup_dir/secrets.key"
find "$backup_root" -mindepth 1 -maxdepth 1 -type d -name '20*' -mtime +14 -exec rm -rf -- {} +
