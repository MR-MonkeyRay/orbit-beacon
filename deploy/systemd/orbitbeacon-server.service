[Unit]
Description=OrbitBeacon Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orbitbeacon
Group=orbitbeacon
StateDirectory=orbitbeacon
StateDirectoryMode=0700
ExecStart=/usr/local/bin/orbitbeacon-server serve --config /etc/orbitbeacon/server.yaml
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
# 若在 server.yaml 中修改了 data_dir，须同步更新此路径
ReadWritePaths=/var/lib/orbitbeacon
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
